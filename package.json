{
  "name": "hive-sight",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:all": "node scripts/dev-servers.mjs start",
    "dev:all:yolo-training": "HIVESIGHT_PERSISTENCE_BACKEND=postgres HIVESIGHT_DATABASE_PURPOSE=dev HIVESIGHT_BEE_TRAINING_ADAPTER=ultralytics_yolo_obb node scripts/dev-servers.mjs start",
    "dev:lan": "node scripts/dev-servers.mjs start --lan",
    "dev:lan:yolo-training": "HIVESIGHT_PERSISTENCE_BACKEND=postgres HIVESIGHT_DATABASE_PURPOSE=dev HIVESIGHT_BEE_TRAINING_ADAPTER=ultralytics_yolo_obb node scripts/dev-servers.mjs start --lan",
    "dev:status": "node scripts/dev-servers.mjs status",
    "dev:status:lan": "node scripts/dev-servers.mjs status --lan",
    "dev:stop": "node scripts/dev-servers.mjs stop",
    "db:up": "docker compose up -d postgres",
    "db:migrate": "cd services/core-api && HIVESIGHT_DATABASE_PURPOSE=dev CORE_API_DATABASE_URL=postgresql://hive_sight:hive_sight@localhost:5432/hive_sight_core_dev ./.venv/bin/python -m hive_sight_core_api.db migrate",
    "db:migrate:test": "cd services/core-api && HIVESIGHT_DATABASE_PURPOSE=test CORE_API_DATABASE_URL=postgresql://hive_sight:hive_sight@localhost:5432/hive_sight_core_test ./.venv/bin/python -m hive_sight_core_api.db migrate",
    "db:migrate:qa": "cd services/core-api && HIVESIGHT_DATABASE_PURPOSE=qa CORE_API_DATABASE_URL=postgresql://hive_sight:hive_sight@localhost:5432/hive_sight_core_qa ./.venv/bin/python -m hive_sight_core_api.db migrate",
    "db:migrate:all": "pnpm db:migrate && pnpm db:migrate:test && pnpm db:migrate:qa",
    "db:seed": "cd services/core-api && HIVESIGHT_DATABASE_PURPOSE=dev CORE_API_DATABASE_URL=postgresql://hive_sight:hive_sight@localhost:5432/hive_sight_core_dev ./.venv/bin/python -m hive_sight_core_api.db seed-dev",
    "db:reset": "cd services/core-api && HIVESIGHT_DATABASE_PURPOSE=test CORE_API_DATABASE_URL=postgresql://hive_sight:hive_sight@localhost:5432/hive_sight_core_test ./.venv/bin/python -m hive_sight_core_api.db reset-test",
    "db:reset:dev": "cd services/core-api && HIVESIGHT_DATABASE_PURPOSE=dev CORE_API_DATABASE_URL=postgresql://hive_sight:hive_sight@localhost:5432/hive_sight_core_dev ./.venv/bin/python -m hive_sight_core_api.db reset-dev",
    "dev:web": "pnpm --filter @hive-sight/web dev",
    "build:web": "pnpm --filter @hive-sight/web build",
    "check:web": "pnpm --filter @hive-sight/web check",
    "test:acceptance:web": "pnpm --filter @hive-sight/web test:acceptance",
    "model:setup:yolo": "node scripts/model-setup-yolo.mjs",
    "model:train:bee:yolo": "node scripts/model-train-bee-yolo.mjs",
    "model:qa:bee:yolo": "node scripts/model-qa-bee-yolo.mjs",
    "model:qa:bee:prelabel": "node scripts/model-qa-bee-prelabel.mjs",
    "verify:slice": "node scripts/verify-slice.mjs"
  }
}
